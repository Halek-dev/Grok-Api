# Never commit the key or the spend record.
# .env.* covers backups and per-machine variants (.env.local, .env.bak, ...),
# which is how a real key nearly got staged once.
.env
.env.*
!.env.example
usage.jsonl
images/
# Photos people attached to edits. Real people's pictures: never commit them.
sources/
# Images deleted a moment ago, held so a delete can be undone.
trash/
favourites.json
# The team's prompt library. Their words, not the repo's.
prompts.json
prompts.json.tmp

node_modules/
npm-debug.log*
.DS_Store
Thumbs.db

# Local snapshots kept so a UI change can be undone. Not for the repo.
.rollback/

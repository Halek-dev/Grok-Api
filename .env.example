# Copy this file to .env and fill in the key. .env is gitignored.

# Required. The team key from https://console.x.ai — this is the only place it
# should ever live. It is never sent to the browser.
XAI_API_KEY=xai-your-key-here

# Optional. When set, every /api route except /api/config requires it as an
# x-team-password header. Leave blank and anyone who can reach the port can
# spend the team credits.
TEAM_PASSWORD=

# Optional. Defaults below.
PORT=8787
HOST=0.0.0.0

# Optional. How long to wait for xAI before giving up, in milliseconds.
# Default 180000 (three minutes).
UPSTREAM_TIMEOUT_MS=180000

# Optional. Where generated images and usage.jsonl are kept. Defaults to the
# project folder. On a host with an ephemeral filesystem — Railway, Fly, most
# container platforms — point this at a MOUNTED VOLUME, or every redeploy
# throws away the saved images and the spend record.
# On Railway you do not need this: attach a volume and the server uses it on its
# own. Set it only to choose a folder inside the volume, or on another host.
# DATA_DIR=/data

# Optional. Set to false to stop saving generated images to disk. Results then
# live in the browser tab only and a refresh empties the page.
SAVE_IMAGES=true

# Optional. Oldest images are deleted past this count, so a disk cannot fill up
# unattended. A 2k PNG is around 6 MB, so 400 is roughly 2.5 GB at worst.
MAX_STORED_IMAGES=400

# Optional. How long, in milliseconds, to let requests in flight finish when the
# server is told to stop (a redeploy). Default 8000. A picture takes 15-25
# seconds, so to protect one that is mid-render raise this AND the host's own
# limit — on Railway, RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60 with this at 55000.
# SHUTDOWN_GRACE_MS=8000

# Optional. What the studio calls itself — the top bar, the password screen and
# the browser tab. Default "Imagine studio".
# STUDIO_NAME=Imagine studio

# Optional. An xAI MANAGEMENT key (console: Settings > Management Keys) — not
# the API key above. When set, the top bar shows how much prepaid credit is
# left, beside what was spent today. Used for two read-only billing calls and
# never sent to the browser. Leave unset and only "spent today" is shown.
# XAI_MANAGEMENT_KEY=

# Optional. A Google AI Studio key (https://aistudio.google.com → Get API key)
# with BILLING ENABLED on its Google Cloud project — Nano Banana Pro has no free
# tier. When set, "Nano Banana Pro" appears in the Model list beside xAI's
# models, with 1K, 2K and 4K. Never sent to the browser. Leave unset and only
# xAI's models are offered.
# GOOGLE_API_KEY=

# Optional. What Google may cost in a month, in USD. Google is pay-as-you-go
# on a card and has no balance to read, so this is the line the studio holds:
# the profile card (the avatar, top right) shows how much of it is gone, the
# avatar gets an amber dot when the last fifth or the last $5 is reached, and
# a Google picture past the line is refused. Unset: the figures only, no line.
# GOOGLE_MONTHLY_ALLOWANCE=100

# Optional. Which of Google's two calls to make: "interactions" (the one Google
# documents, default) or "generateContent" (the older one). Both give the same
# picture; this is a switch for the day one of them misbehaves.
# GOOGLE_API=interactions

# Optional. Only for a stub while testing. Default https://generativelanguage.googleapis.com
# GOOGLE_BASE_URL=

# Optional. The chat model behind /api/describe, which reads photographs and
# answers in text. It must accept image input. Default grok-4.20-non-reasoning.
VISION_MODEL=grok-4.20-non-reasoning

# Optional. Only for routing through a gateway, or pointing at a stub while
# testing. Must speak the same API as api.x.ai. Default https://api.x.ai/v1
XAI_BASE_URL=https://api.x.ai/v1
